DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,your-ec2-public-ip

FRONTEND_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_CREDENTIALS=true

# Leave MONGO_URI empty to use SQLite.
MONGO_URI=
MONGO_DB_NAME=quiz-master
DB_CONN_MAX_AGE=0

# Optional but recommended if you run more than one Daphne process.
REDIS_URL=redis://127.0.0.1:6379/0

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_HOST=true

DRF_THROTTLE_USER=2000/day
DRF_THROTTLE_ANON=500/day
QUIZ_LOG_LEVEL=INFO
