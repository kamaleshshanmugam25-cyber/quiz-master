[Unit]
Description=Quiz Master Daphne ASGI service
After=network.target redis-server.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/quiz-master/quiz_master/backend
EnvironmentFile=/home/ubuntu/quiz-master/quiz_master/backend/.env
ExecStart=/home/ubuntu/quiz-master/quiz_master/backend/.venv/bin/daphne -b 127.0.0.1 -p 8000 backend.asgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
